#!/usr/bin/env ruby
# Rulepack CLI — single entry point for all Rulepack operations
# Usage: rulepack <command> [options]

require "pathname"
require "fileutils"
require "yaml"

ROOT = Pathname.new(__dir__).parent.expand_path
$LOAD_PATH.unshift(ROOT.to_s)

require "lib/rulepack/encoding_defaults"
require "lib/rulepack/errors"
require "lib/rulepack/models/package"
require "lib/rulepack/models/platform"
require "lib/rulepack/models/target"
require "lib/rulepack/common"
require "lib/rulepack/query"
require "lib/rulepack/audit"
require "lib/rulepack/build"
require "lib/rulepack/aggregate"
require "lib/rulepack/installer"
require "lib/rulepack/uninstaller"
require "lib/rulepack/verify"
require "lib/rulepack/fix"
require "lib/rulepack/outdated"
require "lib/rulepack/bump"
require "lib/rulepack/reporter"
require "lib/rulepack/emitter"
require "lib/rulepack/reporter/console_renderer"
require "lib/rulepack/catalog/remote_catalog"
require "lib/rulepack/lockfile"

# Wire the default console renderer so emit() calls produce stdout output.
Rulepack::Reporter::ConsoleRenderer.new

# Handle SIGINT gracefully
trap('INT') do
  warn "\n⚠️  Command interrupted by user. Exiting cleanly."
  exit 130
end

module Rulepack
  module CLI
    VALID_COMMANDS = %w[install uninstall query fix build bump list show search status audit check verify outdated catalog platforms init-hooks remote lock help].freeze

    def self.run(argv)
      if argv.include?('--timing')
        Rulepack::Logging.show_timing = true
        argv.delete('--timing')
      end

      command = argv.shift || "help"

      # Map pacman-style flags to their respective standard commands
      case command
      when '-S'
        command = 'install'
        argv.unshift('-S')
      when '-R'
        command = 'uninstall'
        argv.unshift('-R')
      when '-Qk'
        command = 'verify'
        argv.unshift('-Qk')
      when '-F'
        command = 'fix'
        argv.unshift('-F')
      when '-Q'
        command = 'query'
        argv.unshift('-Q')
      end

      if ['-h', '--help', 'help'].include?(command)
        print_help
        return 0
      end

      full_argv = argv
      options = Rulepack::CliParser.parse(full_argv)
      format = options[:format] || :text

      case command
      when "build"
        r = dispatch_build(full_argv)
        return r if r != 0
        dispatch_aggregate(full_argv)
      when "install"
        dispatch_install(full_argv)
      when "uninstall"
        dispatch_uninstall(full_argv)
      when "audit"
        result = Rulepack::Audit.run(argv)
        result.failure? ? 1 : 0
      when "query"
        Rulepack::Query.run(options[:positional] || argv, format: format)
      when "list"
        Rulepack::Query.run(["list-packages"] + (options[:positional] || argv), format: format)
      when "show"
        Rulepack::Query.run(["show"] + (options[:positional] || argv), format: format)
      when "search"
        Rulepack::Query.run(["search"] + (options[:positional] || argv), format: format)
      when "status"
        print_status
        0
      when "check"
        dispatch_install(["--check", "--target", options[:target].to_s].compact + (options[:positional] || []))
      when "verify"
        dispatch_verify(full_argv)
      when "fix"
        dispatch_fix(full_argv)
      when "outdated"
        dispatch_outdated(full_argv)
      when "catalog"
        catalog_path = ROOT.join("build", "catalog.json")
        unless catalog_path.exist?
          puts "Catalog not found. Run `rulepack build` first."
          return 0
        end
        puts catalog_path.read
        0
      when "platforms"
        Rulepack::Query.run(["list-platforms"], format: format)
      when "bump"
        dispatch_bump(full_argv)
      when "init-hooks"
        Rulepack::CLI.init_hooks
      when "remote"
        dispatch_remote(argv)
      when "lock"
        dispatch_lock(argv)
      when "help"
        print_help
        0
      else
        warn "\e[31m❌ Unknown command: '#{command}'\e[0m"
        if defined?(DidYouMean::SpellChecker)
          corrections = DidYouMean::SpellChecker.new(dictionary: VALID_COMMANDS).correct(command)
          warn "💡 Did you mean? \e[1mrulepack #{corrections.first}\e[0m" if corrections.any?
        end
        warn "\nRun \e[1mrulepack help\e[0m to see a list of available commands."
        1
      end
    rescue Rulepack::Error => e
      warn "Error: #{e.message}"
      1
    end

    # Direct backend dispatch — no load/eval, no $rulepack_exit_code side channel.
    # Each method: parse → call backend → render → return exit code.

    def self.dispatch_build(argv)
      opts = Rulepack::CliParser.parse(argv)
      result = Rulepack::Build.run(opts)
      Rulepack::Reporter.print(result, format: opts[:format] || :text)
      result.failure? ? 1 : 0
    rescue StandardError => e
      $stderr.puts "❌ Error: #{e.message}"
      1
    end

    def self.dispatch_aggregate(argv)
      opts = Rulepack::CliParser.parse(argv)
      Rulepack::Aggregate.run(opts)
      0
    rescue StandardError => e
      $stderr.puts "❌ Error: #{e.message}"
      1
    end

    def self.dispatch_install(argv)
      opts = Rulepack::CliParser.parse(argv)
      if opts[:positional]&.size.to_i > 1
        warn "❌ Error: Too many positional arguments. Usage: rulepack install [package] --target <platform|all>"
        return 1
      end
      result = Rulepack::Install.dispatch(opts)
      render_result(result, opts)
    rescue StandardError => e
      warn "❌ Error: #{e.message}"
      1
    end

    def self.dispatch_uninstall(argv)
      opts = Rulepack::CliParser.parse(argv)
      if opts[:positional]&.size.to_i > 1
        warn "❌ Error: Too many positional arguments. Usage: rulepack uninstall [package] --target <platform|all>"
        return 1
      end
      result = Rulepack::Uninstaller.dispatch(opts)
      render_result(result, opts)
    rescue StandardError => e
      warn "❌ Error: #{e.message}"
      1
    end

    def self.dispatch_verify(argv)
      opts = Rulepack::CliParser.parse(argv)
      result = Rulepack::Verify.run(opts.merge(exit_on_failure: false))
      result.failure? ? 1 : 0
    rescue StandardError => e
      $stderr.puts "❌ Error: #{e.message}"
      1
    end

    def self.dispatch_fix(argv)
      opts = Rulepack::CliParser.parse(argv)
      result = Rulepack::Fix.run(opts)
      render_result(result, opts)
    rescue StandardError => e
      $stderr.puts "❌ Error: #{e.message}"
      1
    end

    def self.dispatch_outdated(argv)
      opts = Rulepack::CliParser.parse(argv)
      result = Rulepack::Outdated.run(opts)
      if result.failure?
        render_failure(result, opts)
        1
      else
        Rulepack::Reporter.print(result, format: opts[:format] || :text)
        result.partial? ? 1 : 0
      end
    rescue StandardError => e
      $stderr.puts "❌ Error: #{e.message}"
      1
    end

    def self.dispatch_bump(argv)
      Rulepack::Bump.run(argv)
      0
    rescue StandardError => e
      $stderr.puts "❌ Error: #{e.message}"
      1
    end

    def self.dispatch_remote(argv)
      subcommand = argv.shift
      index_url = ENV['RULEPACK_REMOTE_INDEX'] || 'https://packages.rulepack.dev/index.json'

      case subcommand
      when 'search'
        term = argv.shift
        unless term
          warn "Usage: rulepack remote search <term>"
          return 1
        end
        catalog = Rulepack::Catalog::RemoteCatalog.new(index_url)
        results = catalog.search(term)
        if results.empty?
          puts "No packages found for '#{term}'."
        else
          results.each do |pkg|
            puts "  #{pkg[:name]} (#{pkg[:version]}) — #{pkg[:description]}"
          end
        end
        0
      when 'list'
        catalog = Rulepack::Catalog::RemoteCatalog.new(index_url)
        catalog.list.each do |pkg|
          puts "  #{pkg[:name]} (#{pkg[:version]})"
        end
        0
      else
        warn "Usage: rulepack remote <search|list> [args]"
        warn "  Set RULEPACK_REMOTE_INDEX to override the index URL."
        1
      end
    rescue StandardError => e
      $stderr.puts "❌ Error: #{e.message}"
      1
    end

    def self.dispatch_lock(argv)
      lockfile = Rulepack::Lockfile.new
      entries = lockfile.entries
      if entries.empty?
        puts "No lockfile entries. Run `rulepack lock --add <pkg> --version <ver>` to pin a package."
      else
        puts "Lockfile entries (#{entries.size}):"
        entries.each do |name, entry|
          puts "  #{name} @ #{entry['version']}"
        end
      end
      0
    rescue StandardError => e
      $stderr.puts "❌ Error: #{e.message}"
      1
    end

    # Shared rendering helpers

    def self.render_result(result, opts)
      if result.failure?
        render_failure(result, opts)
        1
      else
        Rulepack::Reporter.print(result, format: opts[:format] || :text)
        0
      end
    end

    def self.render_failure(result, opts)
      if (opts[:format] || :text).to_sym == :text
        result.messages.each { |m| warn m }
        result.errors.each { |e| warn "Error: #{e}" }
      else
        Rulepack::Reporter.print(result, format: opts[:format])
      end
    end

    def self.print_help
      puts <<~HELP
        Rulepack — Single Source of Truth for Agent Rules & Skills

        Usage: rulepack <command> [options]

        Pacman-style commands:
          install <platform|package>   Install packages to a platform
          uninstall <platform>         Remove packages from a platform
          query <cmd>                  Query package database
          fix [platform]               Repair drift (index-disk reconciliation)

        Makepkg-style commands:
          build                        Build all packages (fetch → transform → artifacts)
          bump [pkg] [--apply]         Check upstream for new versions; --apply to auto-update

        Other commands:
          list                         List all packages
          show <pkgname>               Show package details
          search <tag>                 Search packages by tag
          status                       Show overall system status
          audit [options]              Audit all PKGBUILD descriptors for schema compliance
          check <platform>             Verify installed state matches index
          verify [platform]            Comprehensive index vs disk reconciliation
          outdated [platform]          Show installed packages older than the build
          catalog                      Show package catalog (JSON)
          platforms                    List all platforms
          remote search <term>         Search remote package index
          remote list                  List remote packages
          lock                         Show lockfile status
          init-hooks                   Install git pre-commit hook

        Global Flags:
          --timing                     Show operation timing
          --verbose, -v                Show debug output

        Install Flags (pacman-style):
          --target PLATFORM            Install single package to specific platform
          --needed                     Skip already-installed packages
          --dry-run                    Preview without changes
          --force, -f                  Allow downgrades (pacman -f/--force)

        Examples:
          rulepack build && rulepack install opencode
          rulepack install rulepkg --target opencode --needed
          rulepack install opencode --dry-run       # dry-run preview
          rulepack install --all --needed
          rulepack uninstall opencode
          rulepack status
          rulepack search security
          rulepack verify opencode
          rulepack fix opencode
          rulepack outdated --target opencode
          rulepack audit --strict
      HELP
    end

    def self.print_status
      index_path = ROOT.join("data", "index.yaml")
      unless File.exist?(index_path)
        puts "  No index found. Run `rulepack build` first."
        return
      end
      index = Rulepack::IO.load_yaml(Pathname.new(index_path)) || {}
      total = index[:packages]&.size || 0
      installed_platforms = {}
      index[:packages]&.each do |name, pkg|
        Array(pkg[:installed]).each do |rec|
          platform = rec[:platform]
          installed_platforms[platform] ||= []
          installed_platforms[platform] << name.to_s
        end
      end

      puts "📦 Rulepack Status"
      puts "  Total packages: #{total}"
      puts "  Platforms: #{installed_platforms.size}"
      puts
      installed_platforms.each do |platform, pkgs|
        puts "  #{platform}: #{pkgs.size} package(s)"
        pkgs.each { |p| puts "    - #{p}" }
      end
    end

    def self.init_hooks
      hook_dir = ROOT.join(".git", "hooks")
      unless File.exist?(hook_dir)
        puts "❌ Error: Not a git repository (.git/hooks directory not found)."
        return 1
      end

      pre_commit_hook = hook_dir.join("pre-commit")
      hook_content = <<~HOOK
        #!/bin/sh
        # Rulepack git pre-commit hook
        # Automatically runs PKGBUILD audit and drift verification before commits
        
        echo "🔍 Rulepack Pre-Commit Audit..."
        ruby bin/rulepack audit --strict
        AUDIT_STATUS=$?
        if [ $AUDIT_STATUS -ne 0 ]; then
          echo "❌ Rulepack pre-commit audit failed! Commit aborted."
          exit 1
        fi
        
        echo "✓ Rulepack pre-commit audit passed."
        exit 0
      HOOK

      File.write(pre_commit_hook, hook_content)
      File.chmod(0755, pre_commit_hook)
      puts "✅ Git pre-commit hook installed successfully at #{pre_commit_hook.relative_path_from(ROOT)}"
      0
    end
  end
end

exit Rulepack::CLI.run(ARGV)
